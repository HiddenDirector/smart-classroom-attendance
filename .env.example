# Copy to .env and adjust. Every value here is optional — defaults in config.py.

# --- Flask ---
SECRET_KEY=generate-a-long-random-string
FLASK_ENV=development

# --- Database (defaults to SQLite in ./database/attendance.db) ---
# DATABASE_URL=postgresql://user:pass@localhost/attendance

# --- Camera ---
CAMERA_INDEX=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# --- Motion detection ---
MOTION_MIN_AREA=1500
MOTION_ACTIVE_HOLD_SECONDS=5.0

# --- Face recognition ---
RECOGNITION_CONFIDENCE_THRESHOLD=0.55
RECOGNITION_FRAME_INTERVAL=5
RECOGNITION_MODEL=hog

# --- Attendance rules ---
CLASS_START_TIME=09:00
LATE_AFTER_MINUTES=15

# --- Pipeline ---
PIPELINE_AUTOSTART=false

# --- Email reports (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=app-password
# REPORT_RECIPIENTS=head@example.com,office@example.com
